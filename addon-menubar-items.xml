<?xml version="1.0" encoding="UTF-8"?>
<PropertyList>
  <meta>
    <file-type type="string">FlightGear add-on menu bar items</file-type>
    <format-version type="int">1</format-version>
  </meta>

  <menubar-items>
    <menu>
      <label>Aerobatic Judge</label>
      <enabled type="bool">true</enabled>
      <item>
        <label>Open scoring panel</label>
        <binding>
          <command>nasal</command>
          <script>aerojudge.showDialog();</script>
        </binding>
      </item>
      <item>
        <label>Arm: Steep turn</label>
        <binding><command>nasal</command><script>aerojudge.armKey("steep");</script></binding>
      </item>
      <item>
        <label>Arm: Aileron roll</label>
        <binding><command>nasal</command><script>aerojudge.armKey("roll");</script></binding>
      </item>
      <item>
        <label>Arm: Four-point roll</label>
        <binding><command>nasal</command><script>aerojudge.armKey("fourpoint");</script></binding>
      </item>
      <item>
        <label>Arm: Loop</label>
        <binding><command>nasal</command><script>aerojudge.armKey("loop");</script></binding>
      </item>
      <item>
        <label>Arm: Immelmann</label>
        <binding><command>nasal</command><script>aerojudge.armKey("immelmann");</script></binding>
      </item>
      <item>
        <label>Arm: Split-S</label>
        <binding><command>nasal</command><script>aerojudge.armKey("splits");</script></binding>
      </item>
      <item>
        <label>Disarm / reset</label>
        <binding>
          <command>nasal</command>
          <script>aerojudge.disarm();</script>
        </binding>
      </item>
    </menu>
  </menubar-items>
</PropertyList>
